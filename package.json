{
  "name": "mcp-tty",
  "version": "0.1.0",
  "description": "MCP server exposing a persistent, interactive PTY-backed shell for AI agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7ez/mcp-tty.git"
  },
  "homepage": "https://github.com/7ez/mcp-tty#readme",
  "bugs": "https://github.com/7ez/mcp-tty/issues",
  "type": "module",
  "bin": {
    "mcp-tty": "dist/index.js"
  },
  "files": [
    "dist",
    "patches"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "node-pty": "^1.0.0",
    "strip-ansi": "^7.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "patch-package": "^8.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
